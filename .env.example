# Local Docker Compose settings only. Never use these example values in staging or production.
POSTGRES_DB=ghl_aura
POSTGRES_USER=ghl_aura
POSTGRES_PASSWORD=replace-with-a-unique-local-password

# Use a random value of at least 32 characters for local development.
JWT_SECRET_KEY=replace-with-a-unique-random-secret-of-at-least-32-characters

# Optional integrations. Leave empty until you configure local test credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENABLE_SSL=true
SMTP_SENDER_NAME=GHL Aura Local
SMTP_SENDER_EMAIL=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_CLIENT_BASE_URL=http://localhost:5173

TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
TWILIO_TWIML_APP_SID=
TWILIO_CALLER_NUMBER=
TWILIO_AUTH_TOKEN=
